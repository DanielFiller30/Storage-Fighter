        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne deine Bestätigung wird nichts entfernt."
          }
        }
      }
    },
    "Nothing is removed without your confirmation; the default is the Trash.": {
      "localizations": {
