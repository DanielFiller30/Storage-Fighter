    "e.g. Weekly developer clean-up": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "z. B. Wöchentliche Entwickler-Bereinigung"
          }
        }
      }
    },
    "iCloud Drive or cloud storage; removing it would delete it everywhere.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud Drive oder Cloud-Speicher; Entfernen würde es überall löschen."
          }
        }
      }
    },
    "iOS, watchOS, tvOS or visionOS versions for the Simulator. Xcode can download them again (several GB each). Removal uses Xcode's own command.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS-, watchOS-, tvOS- oder visionOS-Versionen für den Simulator. Xcode kann sie erneut laden (jeweils mehrere GB). Entfernt wird mit Xcodes eigenem Befehl."
          }
        }
      }
    },
    "iPhone and iPad Backups": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone- und iPad-Backups"
          }
        }
      }
    },
    "macOS asks for approval in System Settings → General → Login Items.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS fragt in Systemeinstellungen → Allgemein → Anmeldeobjekte nach deiner Zustimmung."
          }
        }
      }
    },
    "macOS currently estimates %@ as removable on demand; snapshots are part of this. Their individual size is not reported.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS schätzt derzeit %@ als bei Bedarf entfernbar; Snapshots sind ein Teil davon. Ihre einzelne Größe wird nicht gemeldet."
          }
        }
      }
    },
    "macOS frees this on demand: caches, local snapshots, optimised iCloud files": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS gibt das bei Bedarf frei: Caches, lokale Snapshots, optimierte iCloud-Dateien"
          }
        }
      }
    },
