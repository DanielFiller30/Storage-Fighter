        }
      }
    },
    "Nothing is removed automatically. Suggestions are collected and confirmed in a later step. Last analysed %@.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wird automatisch entfernt. Vorschläge werden in einem späteren Schritt gesammelt und bestätigt. Zuletzt analysiert %@."
          }
