{
  "sourceLanguage": "en",
  "strings": {
    "%@ available on %@. Open Stofi to see what takes up space.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ verfügbar auf %2$@. Öffne Stofi, um zu sehen, was Platz belegt."
          }
        }
      }
    },
    "%@ folders could not be read. Full Disk Access would allow Stofi to measure them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Ordner konnten nicht gelesen werden. Mit vollständigem Festplattenzugriff könnte Stofi sie messen."
          }
        }
      }
    },
    "%@ folders could not be read; their size is missing.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Ordner konnten nicht gelesen werden; ihre Größe fehlt."
          }
        }
      }
    },
    "%@ items": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Einträge"
          }
        }
      }
    },
    "%@ items · %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Einträge · %2$@"
          }
        }
      }
    },
    "%@ items · %@ · prepared %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Einträge · %2$@ · vorbereitet %3$@"
          }
        }
      }
    },
    "%@ items, %@. Nothing has been removed; open Stofi to review and confirm.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ Einträge, %2$@. Es wurde nichts entfernt; öffne Stofi, um zu prüfen und zu bestätigen."
          }
        }
      }
    },
    "%@ moved to the Trash. The space is freed when the Trash is emptied.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ in den Papierkorb gelegt. Der Platz wird frei, sobald der Papierkorb geleert wird."
          }
        }
      }
    },
    "%@ of %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ von %2$@"
          }
        }
      }
    },
    "%@ of %@ items processed": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ von %2$@ Einträgen verarbeitet"
          }
        }
      }
    },
    "%@ snapshots": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Snapshots"
          }
        }
      }
    },
    "%@ total": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gesamt"
          }
        }
      }
    },
    "%@ · %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        }
      }
    },
    "%@ · %@ files": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@ Dateien"
          }
        }
      }
    },
    "%@ · files smaller than 1 MB in this folder": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · Dateien unter 1 MB in diesem Ordner"
          }
        }
      }
    },
    "%lld days": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Tage"
          }
        }
      }
    },
    "%lld min": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Min."
          }
        }
      }
    },
    "A location from an activity profile.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ort aus einem Tätigkeitsprofil."
          }
        }
      }
    },
    "A main folder of your Library, needed by apps.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Hauptordner deiner Library, den Apps benötigen."
          }
        }
      }
    },
    "A main folder of your home folder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Hauptordner deines Benutzerordners."
          }
        }
      }
    },
    "A whole disk or the disks folder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein ganzes Volume oder der Volumes-Ordner."
          }
        }
      }
    },
    "About Stofi": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über Stofi"
          }
        }
      }
    },
    "Activities for the quickscan": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätigkeiten für den Quickscan"
          }
        }
      }
    },
    "Add recommendations, items from the list or areas of the storage map. Nothing is removed until you confirm.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge Empfehlungen, Einträge aus der Liste oder Bereiche der Speicherkarte hinzu. Es wird nichts entfernt, bevor du bestätigst."
          }
        }
      }
    },
    "Add to Selection": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zur Auswahl hinzufügen"
          }
        }
      }
    },
    "Add to the selection; nothing is removed yet": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zur Auswahl hinzufügen; noch wird nichts entfernt"
          }
        }
      }
    },
    "Allow Full Disk Access…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vollständigen Festplattenzugriff erlauben …"
          }
        }
      }
    },
    "Almost full": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast voll"
          }
        }
      }
    },
    "Already in the selection": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits in der Auswahl"
          }
        }
      }
    },
    "An app's container itself.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Container einer App selbst."
          }
        }
      }
    },
    "Analyse Again": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erneut analysieren"
          }
        }
      }
    },
    "Analyse Everything": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles analysieren"
          }
        }
      }
    },
    "Analyse the selected disk or folder (read-only)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgewähltes Volume oder ausgewählten Ordner analysieren (nur lesend)"
          }
        }
      }
    },
    "Analysing…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysiere …"
          }
        }
      }
    },
    "Analysis": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse"
          }
        }
      }
    },
    "Android Emulators (AVD)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Android-Emulatoren (AVD)"
          }
        }
      }
    },
    "Android emulator images including their state (installed apps, data). They can be created again in Android Studio.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Android-Emulator-Images samt Zustand (installierte Apps, Daten). Sie lassen sich in Android Studio neu anlegen."
          }
        }
      }
    },
    "Any size": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beliebige Größe"
          }
        }
      }
    },
    "App Caches": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Caches"
          }
        }
      }
    },
    "App Data": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "App-Daten"
          }
        }
      }
    },
    "App builds created with Product → Archive. They are needed to symbolicate crash reports or to submit that exact build again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Product → Archive erstellte App-Builds. Sie werden benötigt, um Absturzberichte zu symbolisieren oder genau diesen Build erneut einzureichen."
          }
        }
      }
    },
    "Applications": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Programme"
          }
        }
      }
    },
    "Apps are not removed by Stofi.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stofi entfernt keine Apps."
          }
        }
      }
    },
    "Apps keep temporary copies here to start and load faster. Removing them is safe; apps rebuild what they need, which can make them slower the first time. Quit an app before removing its cache.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps legen hier temporäre Kopien ab, um schneller zu starten und zu laden. Das Entfernen ist unkritisch; Apps erzeugen Benötigtes neu und sind dadurch beim ersten Mal etwas langsamer. Beende eine App, bevor du ihren Cache entfernst."
          }
        }
      }
    },
    "Apps, documents and system data": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps, Dokumente und Systemdaten"
          }
        }
      }
    },
    "As of %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stand: %@"
          }
        }
      }
    },
    "At the chosen time, or when space gets low, Stofi measures the selected categories and prepares a selection. Nothing is removed automatically: you review it and confirm in the usual dialog. Jobs run while Stofi is open; missed times are caught up once.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zur gewählten Zeit oder bei knappem Speicher misst Stofi die gewählten Kategorien und bereitet eine Auswahl vor. Es wird nichts automatisch entfernt: Du prüfst und bestätigst im gewohnten Dialog. Jobs laufen, solange Stofi geöffnet ist; verpasste Termine werden einmal nachgeholt."
          }
        }
      }
    },
    "Attachments in Mail": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anhänge in Mail"
          }
        }
      }
    },
    "Attachments stored inside the Mail database. Shown for information only: removing files there can damage Mail. Delete large messages in Mail instead.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anhänge in der Mail-Datenbank. Nur zur Information: Dateien dort zu entfernen kann Mail beschädigen. Lösche große Nachrichten stattdessen in Mail."
          }
        }
      }
    },
    "Available": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfügbar"
          }
        }
      }
    },
    "Belongs to another user.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gehört einem anderen Benutzer."
          }
        }
      }
    },
    "Build products and indexes of Xcode projects. Xcode recreates them on the next build, which then takes longer.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Build-Produkte und Indizes von Xcode-Projekten. Xcode erzeugt sie beim nächsten Build neu, der dann länger dauert."
          }
        }
      }
    },
    "Bytes": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bytes"
          }
        }
      }
    },
    "Caches & Logs": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Caches & Logs"
          }
        }
      }
    },
    "Can be downloaded again": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kann erneut geladen werden"
          }
        }
      }
    },
    "Can be rebuilt": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lässt sich neu erstellen"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbrechen"
          }
        }
      }
    },
    "Cannot be restored": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht wiederherstellbar"
          }
        }
      }
    },
    "Capacity unavailable": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapazität nicht verfügbar"
          }
        }
      }
    },
    "Categories": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategorien"
          }
        }
      }
    },
    "Category": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategorie"
          }
        }
      }
    },
    "Change Activities…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätigkeiten ändern …"
          }
        }
      }
    },
    "Changed after confirmation and was therefore skipped.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wurde nach der Bestätigung verändert und deshalb übersprungen."
          }
        }
      }
    },
    "Check the typical space hogs of your activities within seconds": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Typische Speicherfresser deiner Tätigkeiten in Sekunden prüfen"
          }
        }
      }
    },
    "Choose Folder…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordner wählen …"
          }
        }
      }
    },
    "Choose a folder to analyse. Stofi only reads it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen Ordner zur Analyse. Stofi liest ihn nur."
          }
        }
      }
    },
    "Choose one or more activities. Stofi then offers a quickscan that checks exactly the places that typically fill up for them, within seconds. Nothing is removed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine oder mehrere Tätigkeiten. Stofi bietet dann einen Quickscan an, der genau die Orte prüft, die dabei typischerweise volllaufen, in Sekunden. Es wird nichts entfernt."
          }
        }
      }
    },
    "Choose what to scan": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auswählen, was analysiert wird"
          }
        }
      }
    },
    "Choose your activities for a quickscan": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tätigkeiten für einen Quickscan wählen"
          }
        }
      }
    },
    "Chosen manually": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Manuell gewählt"
          }
        }
      }
    },
    "Clean Up": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufräumen"
          }
        }
      }
    },
    "Clear Selection": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auswahl leeren"
          }
        }
      }
    },
    "Close": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen"
          }
        }
      }
    },
    "CocoaPods Cache": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "CocoaPods-Cache"
          }
        }
      }
    },
    "Collecting data…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Daten werden gesammelt …"
          }
        }
      }
    },
    "Command failed (%d)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Befehl fehlgeschlagen (%d)"
          }
        }
      }
    },
    "Command finished": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Befehl abgeschlossen"
          }
        }
      }
    },
    "Commands run exactly as shown, without a shell. Their output is shown afterwards.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Befehle laufen genau wie angezeigt, ohne Shell. Ihre Ausgabe wird danach angezeigt."
          }
        }
      }
    },
    "Comparing file contents…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergleiche Dateiinhalte …"
          }
        }
      }
    },
    "Copies of attachments you opened from Mail. The originals stay in the messages.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopien von Anhängen, die du aus Mail geöffnet hast. Die Originale bleiben in den Nachrichten."
          }
        }
      }
    },
    "Critical": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kritisch"
          }
        }
      }
    },
    "Critical below %lld %% available": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kritisch unter %lld %% verfügbar"
          }
        }
      }
    },
    "Current folder: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktueller Ordner: %@"
          }
        }
      }
    },
    "Daily": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Täglich"
          }
        }
      }
    },
    "Daily at %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Täglich um %@"
          }
        }
      }
    },
    "Day %lld of the month": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld. Tag des Monats"
          }
        }
      }
    },
    "Debug symbols Xcode copied from connected devices, one folder per OS version. Xcode copies them again when that device is connected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Debug-Symbole, die Xcode von angeschlossenen Geräten kopiert hat, ein Ordner pro Systemversion. Xcode kopiert sie erneut, wenn das Gerät angeschlossen wird."
          }
        }
      }
    },
    "Delete Job": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Job löschen"
          }
        }
      }
    },
    "Delete Permanently": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Endgültig löschen"
          }
        }
      }
    },
    "Delete permanently?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Endgültig löschen?"
          }
        }
      }
    },
    "Delete this job?": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Job löschen?"
          }
        }
      }
    },
    "Deleted": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelöscht"
          }
        }
      }
    },
    "Deleted permanently": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Endgültig gelöscht"
          }
        }
      }
    },
    "Delete…": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löschen …"
          }
        }
      }
    },
    "Determined with: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ermittelt mit: %@"
          }
        }
      }
    },
    "Developer": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entwickler"
          }
        }
      }
    },
    "Diagnostic logs written by apps. They are only needed to investigate problems.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnoseprotokolle von Apps. Sie werden nur zur Fehlersuche benötigt."
          }
        }
      }
    },
    "Disk": {
      "localizations": {
