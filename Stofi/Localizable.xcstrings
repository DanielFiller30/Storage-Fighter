          }
        }
      }
    },
    "Downloaded Homebrew packages and old versions. Homebrew's own clean-up command removes them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heruntergeladene Homebrew-Pakete und alte Versionen. Homebrews eigener Aufräumbefehl entfernt sie."
          }
        }
      }
    },
    "Downloaded packages kept by a package manager to avoid downloading them again. They are downloaded again when a project needs them.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heruntergeladene Pakete, die ein Paketmanager aufbewahrt, um sie nicht erneut zu laden. Sie werden erneut geladen, wenn ein Projekt sie braucht."
          }
        }
      }
    },
    "Downloads larger than %lld MB": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads größer als %lld MB"
          }
        }
      }
    },
